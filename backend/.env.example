# Copy this file's contents into real environment variables (or an
# untracked .env you load yourself) — never commit actual values.
#
# From your Supabase project: Project Settings -> Database -> Connection string -> JDBC
# It looks like: jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=<your-database-password>

SERVER_PORT=8080
CORS_ALLOWED_ORIGIN=http://localhost:5173

# LegacySupply (Lab 3). ClientId is your student id; ApiKey is given to you
# privately by your instructor — never commit the real value.
LS_CLIENT_ID=<your-student-id>
LS_API_KEY=<your-api-key>
# LS_BASE_URL=https://legacysupply.onrender.com/api/v1  (default, override only if needed)
